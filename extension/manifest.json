{
  "manifest_version": 3,
  "name": "General Manager Project Integrator",
  "version": "1.1.0",
  "description": "Connects ChatGPT project tabs to the General Manager orchestrator via local WebSocket.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
